# ai-dash-macOS Environment Configuration
# Copy to .env and configure as needed
# All values below are defaults or placeholders

# ===========================================
# LLM Provider Configuration
# ===========================================
LLM_PROVIDER=ollama
ALLOW_REMOTE_MODELS=false

# ===========================================
# Ollama Configuration (Local Default)
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# ===========================================
# OpenAI-Compatible API (Optional)
# ===========================================
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===========================================
# Anthropic API (Optional)
# ===========================================
ANTHROPIC_API_KEY=

# ===========================================
# Resource Limits
# ===========================================
MAX_HEAVY_MODELS=1
MAX_AGENT_CONCURRENCY=2
AUTO_UNLOAD_MINUTES=5
REQUEST_TIMEOUT_SECONDS=60
MAX_REQUEST_TOKENS=8192

# ===========================================
# Server Configuration
# ===========================================
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
